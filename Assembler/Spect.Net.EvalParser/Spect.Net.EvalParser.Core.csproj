<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Spect.Net.EvalParser</RootNamespace>
    <AssemblyName>Spect.Net.EvalParser</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="..\AntlrZ80EvalGenerator\AntlrZ80EvalGenerator\Z80Eval.g4">
      <Package>Spect.Net.EvalParser.Generated</Package>
      <Visitor>true</Visitor>
      <Listener>true</Listener>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude old generated files -->
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

</Project>
